<div class="col">
  {% assign sheet_url = project.fiche | default: project.factsheet %}
  {% assign sheet_href = "" %}
  {% assign secondary_button_url = project.secondary_button_url | default: project.second_button_url %}
  {% assign secondary_button_href = "" %}
  {% assign third_button_url = project.third_button_url | default: project.tertiary_button_url %}
  {% assign third_button_href = "" %}
  {% assign partners_label = "Partenaires" %}
  {% if page.lang == "en" %}
    {% assign partners_label = "Partners" %}
  {% endif %}
  {% if sheet_url %}
    {% if sheet_url contains '://' %}
      {% assign sheet_href = sheet_url %}
    {% else %}
      {% assign sheet_href = sheet_url | relative_url %}
    {% endif %}
  {% endif %}
  {% if secondary_button_url %}
    {% if secondary_button_url contains '://' %}
      {% assign secondary_button_href = secondary_button_url %}
    {% else %}
      {% assign secondary_button_href = secondary_button_url | relative_url %}
    {% endif %}
  {% endif %}
  {% if third_button_url %}
    {% if third_button_url contains '://' %}
      {% assign third_button_href = third_button_url %}
    {% else %}
      {% assign third_button_href = third_button_url | relative_url %}
    {% endif %}
  {% endif %}

  <a
    class="project-link"
    href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
    {% unless project.redirect %}data-url="{{ project.url | relative_url }}"{% endunless %}
    data-title="{{ project.title | escape }}"
    data-contacts="{{ project.project_contacts | default: '' | escape }}"
    data-partners="{{ project.project_partners | default: '' | escape }}"
    data-factsheet="{{ sheet_href | escape }}"
    data-secondary-button-url="{{ secondary_button_href | escape }}"
    data-secondary-button-label="{{ project.secondary_button_label | default: project.second_button_label | default: '' | escape }}"
    data-third-button-url="{{ third_button_href | escape }}"
    data-third-button-label="{{ project.third_button_label | default: project.tertiary_button_label | default: '' | escape }}"
    data-img="{{ project.img | default: '' | relative_url }}"
  >
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        {% if project.project_partners %}
          <p class="project-partners"><strong>{{ partners_label }}:</strong> {{ project.project_partners }}</p>
        {% endif %}
        <p class="card-text">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
