<div class="col">
  {% assign partners_label = "Partenaires" %}
  {% assign factsheet_label = "Fiche initiative" %}
  {% if page.lang == "en" %}
    {% assign partners_label = "Partners" %}
    {% assign factsheet_label = "Initiative brief" %}
  {% endif %}
  {% assign sheet_url = project.fiche | default: project.factsheet %}

  <a
    class="project-link"
    href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
    {% unless project.redirect %}data-url="{{ project.url | relative_url }}"{% endunless %}
  >
    <div class="card h-100 hoverable project-card">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h3 class="card-title project-card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>

        {% if project.project_partners %}
          <p class="project-meta"><strong>{{ partners_label }}:</strong> {{ project.project_partners }}</p>
        {% endif %}

        {% if sheet_url %}
          <div class="project-actions">
            <a
              class="btn btn-sm btn-outline-secondary"
              href="{% if sheet_url contains '://' %}{{ sheet_url }}{% else %}{{ sheet_url | relative_url }}{% endif %}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ factsheet_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
