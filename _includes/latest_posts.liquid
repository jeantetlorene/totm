<div class="about-news-grid row g-4">
  {% assign latest_posts = site.posts | slice: 0, 3 %}

  {% if latest_posts.size > 0 %}
    {% for post in latest_posts %}
      <div class="col-lg-4 col-md-6">
        <article class="news-post-card h-100 shadow-sm">
          <a href="{{ post.url | relative_url }}" class="news-post-cover-link" aria-label="{{ post.title }}">
            {% if post.image %}
              <img src="{{ post.image | relative_url }}" class="news-post-img" alt="{{ post.title }}">
            {% else %}
              <div class="news-post-img news-post-img-placeholder"></div>
            {% endif %}
            <span class="news-post-date-chip">{{ post.date | date: "%d %B %Y" }}</span>
          </a>

          <div class="news-post-body d-flex flex-column">
            <h3 class="news-post-title">
              <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
            </h3>

            {% assign preview = post.description | default: post.content %}
            <p class="news-post-text">{{ preview | strip_html | truncate: 140 }}</p>

            <a href="{{ post.url | relative_url }}" class="news-post-cta mt-auto">Lire l'actualité</a>
          </div>
        </article>
      </div>
    {% endfor %}
  {% else %}
    <p class="col-12 mb-0">Aucune actualité publiée pour le moment.</p>
  {% endif %}
</div>
