<div class="bg-light py-5">
  <div class="container">
    <h2 class="text-center mb-4">
      <a href="{{ '/nosactualites/' | relative_url }}">{{ page.news_heading }}</a>
    </h2>

    <div class="d-flex overflow-auto gap-4 px-2" style="scroll-snap-type: x mandatory;">
      {% assign latest_posts = site.posts | slice: 0, 5 %}
      {% for post in latest_posts %}
        <div class="card flex-shrink-0" style="width: 300px; scroll-snap-align: start;">
          {% if post.image %}
            <img src="{{ post.image | relative_url }}" class="card-img-top" alt="{{ post.title }}">
          {% endif %}
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">{{ post.title }}</h5>
            <h6 class="text-muted">{{ post.date | date: "%B %d, %Y" }}</h6>
            {% if post.description %}
              <p class="card-text">{{ post.description | strip_html | truncate: 100 }}</p>
            {% endif %}
            <a href="{{ post.url | relative_url }}" class="btn btn-outline-primary mt-auto">Read more</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>