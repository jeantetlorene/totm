<section class="py-6" style="background-color: var(--section-bg-color);">
  <div class="container">

    <!-- TOP SPLIT -->
    <div class="row align-items-center mb-5">

      <!-- Text LEFT -->
      <div class="col-lg-6">
        <h2 class="mb-4">{{ section.title }}</h2>
        <p>{{ section.intro | markdownify }}</p>
      </div>

      <!-- Image RIGHT -->
      <div class="col-lg-6 text-lg-end mt-4 mt-lg-0">
        <img src="{{ section.image | relative_url }}"
             class="img-fluid rounded-4"
             alt="{{ section.title }}">
      </div>

    </div>

    <!-- FULL WIDTH BLOCKS -->
    {% if section.blocks %}
    <div class="row">
        <div class="col-12">

        {% for block in section.blocks %}

            {% if block.type == "subtitle" %}
            <h3 class="h4 mt-5 mb-4">
                {{ block.title }}
            </h3>
            {% endif %}

            {% if block.type == "highlight" %}
            <div class="p-4 mb-4 bg-white rounded-4 shadow-sm border-start border-4"
                style="border-color: var(--global-theme-color);">
                <h4 class="h6 fw-semibold mb-2">{{ block.title }}</h4>
                {{ block.content | markdownify }}
            </div>
            {% endif %}

            {% if block.type == "text" %}
            <div class="mt-4">
                {{ block.content | markdownify }}
            </div>
            {% endif %}

        {% endfor %}

        </div>
    </div>
    {% endif %}

    <!-- BOTTOM IMAGE -->
    {% if section.bottom_image %}
      <div class="row mt-5">
        <div class="col-12 text-center">
          <img src="{{ section.bottom_image | relative_url }}"
               class="img-fluid rounded-4"
               alt="">
        </div>
      </div>
    {% endif %}

  </div>
</section>