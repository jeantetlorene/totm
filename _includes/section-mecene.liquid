<section class="section mt-3 mb-0 py-3{% if section.background %} bg-light{% endif %}">
  <div class="container">

    <!-- TOP SPLIT -->
    <div class="row align-items-center mb-4">

      <!-- Text LEFT -->
      <div class="col-lg-6">
        <h2 class="h2 mb-3" style="color: var(--global-theme-color);">
        {{ section.title }}
        </h2>
        <p>{{ section.intro | markdownify }}</p>
      </div>

      <!-- Image RIGHT -->
      <div class="col-lg-6 text-lg-end mt-3 mt-lg-0">
        <img src="{{ 'assets/img/' | append: section.image | relative_url }}"
             alt=""
             class="img-fluid rounded-3" />
      </div>

    </div>

    <!-- FULL WIDTH BLOCKS -->
    {% if section.blocks %}
    <div class="row">
      <div class="col-12">

        {% for block in section.blocks %}

          {% if block.type == "subtitle" %}
            <h3 class="h4 mt-2 mb-3">
              {{ block.title }}
            </h3>
          {% endif %}

          {% if block.type == "highlight" %}
            <div class="p-2 mb-1 border-start border-4"
                 style="border-color: var(--global-theme-color);">
              <h4 class="h5 fw-semibold mb-2">{{ block.title }}</h4>
              {{ block.content | markdownify }}
            </div>
          {% endif %}

          

        {% endfor %}

      </div>
    </div>
    {% endif %}

    <!-- BOTTOM IMAGE -->
    {% if section.bottom_image %}
      <div class="row mt-3">
        <div class="col-12 text-center">
          <img src="{{ 'assets/img/' | append: section.bottom_image | relative_url }}"
               class="img-fluid rounded-4"
               alt="">
        </div>
      </div>
    {% endif %}

    {% if section.last_content %}
      <div class="mt-3">
        {{ section.last_content | markdownify }}
      </div>
    {% endif %}

  </div>
</section>