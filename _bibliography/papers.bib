@article{jeantet_combined_2018,
  title = {Climate resilience of fisheries – Is there a risk of collapse of fisheries resources of the Northern Brasilian Shelf marine ecoregion ?},
  year = {2025},
  preview={2.jpg},
  bibtex_show={false},
  abstract = {The session was a continuation of the previous day’s session entitled
            Impact of IUU fishing on northern Brazilian shelf marine eco-complex
            biodiversity and implications of climate change.

            A clear link was established between the high levels of IUU and the
            status of all taxa explored. Session 1 ended with an invitation for
            Session 2 with a focus on the climate resilience of fisheries in the
            northern Brazilian and Guyanese maritime ecoregion, with a
            particular emphasis on Southern Red Snapper and Sciaenidae
            populations.

            An overview of the region's fisheries was provided, highlighting the
            interconnectedness of fishery resources across the Guyana Shield,
            which spans four nations.},
  journal={COP30 - UN Climate Change Conference},
  volume={Session 2 Report},
  dimensions={false},
  selected={true},
  }