@article{cop30_session2_en,
  title = {Climate resilience of fisheries – Is there a risk of collapse of fisheries resources of the Northern Brasilian Shelf marine ecoregion ?},
  year = {2025},
  preview={SUMMARY_SESSION_2_COP_30_NOV_20_2025_En.png},
  bibtex_show={false},
  abstract = {The session was a continuation of the previous day’s session entitled Impact of IUU fishing on northern Brazilian shelf marine eco-complex biodiversity and implications of climate change.
            
            A clear link was established between the high levels of IUU and the status of all taxa explored. Session 1 ended with an invitation for Session 2 with a focus on the climate resilience of fisheries in the northern Brazilian and Guyanese maritime ecoregion, with a particular emphasis on Southern Red Snapper and Sciaenidae populations.
            
            An overview of the region's fisheries was provided, highlighting the interconnectedness of fishery resources across the Guyana Shield, which spans four nations.},
  journal={COP30 - UN Climate Change Conference},
  volume={Session 2 Report},
  dimensions={false},
  pdf={SUMMARY SESSION 2 COP 30 NOV 20 2025 En.pdf},
  selected={false},
  }

@article{cop30_session2_fr,
  title = {Résilience climatique des pêcheries : Existe-t-il un risque d'effondrement des ressources halieutiques de l'écorégion marine du plateau nord-brésilien ?},
  year = {2025},
  preview={SUMMARY_SESSION_2_COP_30_NOV_20_2025_fr.png},
  bibtex_show={false},
  abstract = {La séance s'inscrivait dans la continuité de celle de la veille, intitulée « Impact de la pêche INN sur la biodiversité de l'écosystème marin du plateau continental nord du Brésil et implications du changement climatique ».
                
            Un lien clair a été établi entre les niveaux élevés de pêche INN et l'état de tous les taxons étudiés. La session 1 s'est terminée par une invitation à la session 2, portant sur la résilience climatique des pêcheries dans l'écorégion maritime du nord du Brésil et de la Guyane, avec un accent particulier sur les populations de vivaneaux rouges et de Sciaenidae.
            
            Un aperçu des pêcheries de la région a été présenté, soulignant l'interdépendance des ressources halieutiques à travers le plateau guyanais, qui s'étend sur quatre pays.},
  journal={COP30 - Conférence des Nations unies sur les changements climatiques},
  volume={Session 2 Report},
  dimensions={false},
  pdf={SUMMARY SESSION 2 COP 30 NOV 20 2025 fr.pdf},
  selected={false},
  }