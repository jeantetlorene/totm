---
layout: page
---

<div class="post">
    {% if page.sections %}
      {% for section in page.sections %}
      <section class="section my-5 py-5 {% if section.background %}bg-light{% endif %}">
        <div class="container">
          <div class="row align-items-start">

            {% if section.image_position == "left" %}
            <div class="col-lg-5 text-center mb-4 mb-lg-0">
              <img src="{{ 'assets/img/' | append: section.image | relative_url }}"
                  alt=""
                  class="img-fluid rounded-3" />
            </div>
            {% endif %}

            <div class="col-lg-7">
              <h2 class="h2 mb-3" style="color: var(--global-theme-color);">
                {{ section.title }}
              </h2>

              {% if section.intro %}
                <p class="lead mb-4">{{ section.intro }}</p>
              {% endif %}

              {% if section.blocks %}
                {% for block in section.blocks %}
                  {% if block.subtitle %}
                    <h3 class="h5 mt-4 mb-2">{{ block.subtitle }}</h3>
                  {% endif %}
                  <p>{{ block.content | markdownify }}</p>
                {% endfor %}
              {% endif %}

              {% if section.button.enable %}
                <a href="{{ section.button.link }}"
                  class="btn btn-outline-primary mt-3">
                  {{ section.button.label }}
                </a>
              {% endif %}
            </div>

            {% if section.image_position == "right" %}
            <div class="col-lg-5 text-center mt-4 mt-lg-0">
              <img src="{{ 'assets/img/' | append: section.image | relative_url }}"
                  alt=""
                  class="img-fluid rounded-3" />
            </div>
            {% endif %}

          </div>
        </div>
      </section>
      {% endfor %}
    {% endif %}

    <article>
    <div class="text-center my-5 px-3" style="max-width: 800px; margin-left: auto; margin-right: auto;">
      <h2 class="display-4 mb-4">Contact</h2>
      <p class="lead" style="font-size: 2.0rem;">
         Pour toute question, recommandation, candidature spontanée, prise de contact, écrivez-nous à totm@totm.ong.
      </p>
    </div>


    <!-- Partenair logos -->
    {% if page.clients_logo_slider.enable %}
      <section class="section overflow-hidden py-6 my-5">
        <div class="container">
          <div class="row">
            <div class="col-12 text-center mb-5">
              <h2 class="h3">{{ page.clients_logo_slider.title }}</h2>
            </div>
            <div class="col-12">
              <div class="swiper brand-carousel">
                <div class="swiper-wrapper">
                  {% for logo in page.clients_logo_slider.logos %}
                    <div class="swiper-slide brand-item d-flex align-items-center justify-content-center" style="height: 120px;">
                      <img src="{{ 'assets/img/' | append: logo.light | relative_url }}" 
                          alt="Brand logo light" 
                          class="img-fluid logo-light" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                      <img src="{{ 'assets/img/' | append: logo.dark | relative_url }}" 
                          alt="Brand logo dark" 
                          class="img-fluid logo-dark" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

</div>