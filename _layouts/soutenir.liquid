---
layout: page
---

<div class="post">
    {% if page.sections %}
      {% for section in page.sections %}
        {% case section.layout %}
          {% when "member" %}
            {% include section-member.liquid section=section %}
          {% when "mecene" %}
            {% include /section-mecene.liquid section=section %}
        {% endcase %}
      {% endfor %}
    {% endif %}




    <!-- Partenair logos -->
    {% if page.clients_logo_slider.enable %}
      <section class="section overflow-hidden py-6 my-5">
        <div class="container">
          <div class="row">
            <div class="col-12 text-center mb-5">
              <h2 class="h3">{{ page.clients_logo_slider.title }}</h2>
            </div>
            <div class="col-12">
              <div class="swiper brand-carousel">
                <div class="swiper-wrapper">
                  {% for logo in page.clients_logo_slider.logos %}
                    <div class="swiper-slide brand-item d-flex align-items-center justify-content-center" style="height: 120px;">
                      <img src="{{ 'assets/img/' | append: logo.light | relative_url }}" 
                          alt="Brand logo light" 
                          class="img-fluid logo-light" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                      <img src="{{ 'assets/img/' | append: logo.dark | relative_url }}" 
                          alt="Brand logo dark" 
                          class="img-fluid logo-dark" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <section class="pt-0 py-4" style="position: relative; background-image: url('{{ "/assets/img/apropos.webp" | relative_url }}'); background-size: cover; background-position: center 60%; min-height: 60vh;">
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5);"></div>

      <div class="container h-100 d-flex flex-column justify-content-center align-items-center text-center text-white" style="position: relative; z-index: 1;">
        <h2 style="color: white;" class="display-4 fw-bold mb-4">{{page.hero_heading}}</h2>
        <p style="color: white; margin-top: 5rem;" class="lead mb-5">{{ page.hero_text }}</p>
        <div>
          <a href="{{ page.btn1_url }}" class="btn btn-outline-light btn-lg">{{ page.btn1_text }}</a>
        </div>
      </div>
    </section>

    <!-- Black line separator -->
    <hr style="border: none; border-top: 3px solid black; width: 80%; margin: 0 auto 3rem auto;">


    <article>
    <div class="text-center my-5 px-3" style="max-width: 800px; margin-left: auto; margin-right: auto;">
      <h3 class="display-4 mb-4">Contact</h2>
      <p class="lead" style="font-size: 2.0rem;">
         Pour toute question, recommandation, prise de contact, écrivez-nous à totm@totm.ong.
      </p>
    </div>

</div>