---
layout: default
---
<div class="post">
  
  {% if page.top_image %}
    <div class="top-banner" style="background-image: url('{{ 'assets/img/' | append: page.top_image | relative_url }}');">
      <div class="top-banner-overlay">
        <div class="top-banner-content container">
          {% if page.quote %}
            <h2 class="quote-heading">
              <em style="color: white;">{{ page.quote }}</em>
            </h2>
          {% endif %}

          {% if page.banner_title %}
            <h1 class="display-4 text-white font-weight-bold mb-3">{{ page.banner_title }}</h1>
          {% endif %}
          
          {% if page.banner_subtitle %}
            <p class="lead text-white">{{ page.banner_subtitle }}</p>
          {% endif %}

          {% if page.button.enable %}
              <a href="{{ page.button.link | relative_url }}" class="btn btn-outline-primary btn-lg" style="padding: 1rem 2rem; font-size: 1.25rem;">{{ page.button.label }}</a>
          {% endif %}

        </div>
      </div>
    </div>
  {% endif %}


  <article> 
    <div class="text-center my-5 px-3" style="max-width: 800px; margin-left: auto; margin-right: auto;">
      <p class="lead" style="font-size: 2.0rem;">
         {{ content }}
      </p>
    </div>

    <div class="bg-light py-3">
      <div class="container my-3">
        <!-- Latest posts -->
        {% if page.latest_posts and page.latest_posts.enabled %}
          <h2 class="h1 mb-3">
            <a href="{{ '/nosactualites/' | relative_url }}">
              {{ page.news_heading }}
            </a>
          </h2>
          {% include latest_posts.liquid %}
        {% endif %}
      </div>
    </div>




    {% if page.banners %}
      {% for banner in page.banners %}
      <section class="section mt-5 mb-0 py-5{% if banner.background %} bg-light{% endif %}">
        <div class="container">
          <div class="row align-items-center">
            {% if banner.image_position == "left" %}
            <!-- Image on Left -->
            <div class="col-lg-6 text-center mb-4 mb-lg-0">
              <img src="{{ 'assets/img/' | append: banner.image | relative_url }}" alt="banner image" class="img-fluid rounded-3" />
            </div>
            <div class="col-lg-6">
              <div class="px-lg-4 text-start">
                <h1 class="h1 mb-3" style="color: var(--global-theme-color);">{{ banner.title }}</h1>
                <p class="mb-4">{{ banner.content }}</p>
                {% if banner.button.enable %}
                  <a href="{{ banner.button.link | relative_url }}" class="btn btn-outline-primary">{{ banner.button.label }}</a>
                {% endif %}
              </div>
            </div>
            {% else %}
            <!-- Image on Right -->
            <div class="col-lg-6 order-lg-2 text-center mb-4 mb-lg-0">
              <img src="{{ 'assets/img/' | append: banner.image | relative_url }}" alt="banner image" class="img-fluid rounded-3" />
            </div>
            <div class="col-lg-6 order-lg-1">
              <div class="px-lg-4 text-start">
                <h1 class="h1 mb-3" style="color: var(--global-theme-color);">{{ banner.title }}</h1>
                <p class="mb-4">{{ banner.content }}</p>
                {% if banner.button.enable %}
                  <a href="{{ banner.button.link | relative_url }}" class="btn btn-outline-primary">{{ banner.button.label }}</a>
                {% endif %}
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </section>
      {% endfor %}
    {% endif %}

    {% comment %}
    <section class="container my-5">
      <!-- Gallery CSS -->
      <link rel="stylesheet" href="{{ '/assets/css/gallery.css' | relative_url }}">
      
      <div class="inner">
        <h1 class="h1 mb-3">
          <a href="{{ '/nosinitiatives/' | relative_url }}">
            Programme Initiatives TOTM
          </a>
        </h1>
      </div>

      <!-- Explanatory paragraph -->
      <p class="text-center mx-auto mb-4" style="max-width: 800px;">
        La collaboration entre tous les acteurs de la conservation des tortues marines a conduit à l’élaboration du programme “Initiatives TOTM” initié en 2021 qui vise à répondre aux priorités établies autour de neuf thématiques répondant aux enjeux actuels. Ces initiatives sont destinées à s’inscrire dans les Plans d’Actions locaux et les stratégies internationales, sans s’y substituer.
      </p>


      <div class="gallery style2 medium lightbox onscroll-fade-in">
        {% for item in page.gallery %}
          <article>
            <a href="{{ item.url | relative_url }}" class="image">
              <img src="{{ 'assets/img/' | append: item.thumb | relative_url }}" alt="{{ item.title }}" />
            </a>
            <div class="caption">
              <h3>{{ item.title }}</h3>
              <p>{{ item.description }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
      <!-- Custom Gallery Scripts -->
      <script src="{{ '/assets/js/jquery.min.js' | relative_url }}"></script>
      <script src="{{ '/assets/js/jquery.scrollex.min.js' | relative_url }}"></script>
      <script src="{{ '/assets/js/gallery.js' | relative_url }}"></script>
    </section>
    {% endcomment %}


    <section class="container-fluid bg-light pt-0 py-5">
      <div class="container">
        <!-- White card-like inner content -->
        <div class="p-4 p-md-5 shadow-sm mb-4 rounded custom-card-bg">
          <h1 class="h1 mb-3">
            <a href="{{ page.initiatives_link | relative_url }}">
              {{ page.initiatives_heading }}</h1>
            </a>
          </h1>
          
          <p class="mb-0">
            {{ page.initiatives_text }}
          </p>
        </div>

        <div class="row">

          {% for item in page.gallery %}
            <div class="col-md-4 mb-4">
              <div class="card h-100 border-0 shadow-sm custom-card-bg">
                <a href="{{ item.url | relative_url }}"class="position-relative d-block">
                  <img src="{{ 'assets/img/' | append: item.thumb | relative_url }}" class="card-img-top" alt="{{ item.title }}">
                  <div class="card-img-overlay d-flex align-items-center justify-content-center p-0">
                    <div class="w-100 text-center text-white py-2">
                      <h5 style="color: white;", class="mb-0">{{ item.title }}</h5>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="pt-0 py-4" style="position: relative; background-image: url('{{ "/assets/img/soutenez-nous.webp" | relative_url }}'); background-size: cover; background-position: center 60%; min-height: 60vh;">
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5);"></div>

      <div class="container h-100 d-flex flex-column justify-content-center align-items-center text-center text-white" style="position: relative; z-index: 1;">
        <h2 style="color: white;" class="display-4 mb-4">{{page.hero_heading}}</h2>
        <p style="color: white;" class="lead mb-5">{{ page.hero_text }}</p>
        <div>
          <a href="{{ page.btn1_url }}" class="btn btn-outline-light btn-lg">{{ page.btn1_text }}</a>
          <a href="{{ page.btn2_url }}" class="btn btn-outline-light btn-lg">{{ page.btn2_text }}</a>
          <a href="{{ page.btn3_url | relative_url }}" class="btn btn-outline-light btn-lg">{{ page.btn3_text }}</a>
        </div>
      </div>
    </section>









    <!-- Partenair logos -->
    {% if page.clients_logo_slider.enable %}
      <section class="section overflow-hidden py-6 my-5">
        <div class="container">
          <div class="row">
            <div class="col-12 text-center mb-5">
              <h2 class="h3">{{ page.clients_logo_slider.title }}</h2>
            </div>
            <div class="col-12">
              <div class="swiper brand-carousel">
                <div class="swiper-wrapper">
                  {% for logo in page.clients_logo_slider.logos %}
                    <div class="swiper-slide brand-item d-flex align-items-center justify-content-center" style="height: 120px;">
                      <img src="{{ 'assets/img/' | append: logo.light | relative_url }}" 
                          alt="Brand logo light" 
                          class="img-fluid logo-light" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                      <img src="{{ 'assets/img/' | append: logo.dark | relative_url }}" 
                          alt="Brand logo dark" 
                          class="img-fluid logo-dark" 
                          style="max-height: 100px; width: auto; object-fit: contain;">
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>



</div>
