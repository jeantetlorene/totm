---
layout: default
---

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.img %}
    {% assign initiative_banner = page.img %}
    {% unless initiative_banner contains '://' %}
      {% assign initiative_banner = initiative_banner | relative_url %}
    {% endunless %}
    <div class="initiative-banner" style="background-image: url('{{ initiative_banner }}');">
      <div class="initiative-banner-overlay">
        <div class="initiative-banner-content container">
          <h1 class="post-title">{{ page.title }}</h1>
          {% if page.description %}
            <p class="post-description">{{ page.description }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endif %}

  <article>
    {{ content }}
  </article>

    <!-- INITIATIVE NAVIGATION -->
  
  {% if page.collection == "nosinitiatives" %}
    
    
    {% assign initiatives = site.nosinitiatives
   | where: "lang", page.lang
   | sort: "order" %}

    {% for initiative in initiatives %}
      {% if initiative.url == page.url %}
        {% assign index = forloop.index0 %}
      {% endif %}
    {% endfor %}

    {% assign prev_index = index | minus: 1 %}
    {% assign next_index = index | plus: 1 %}

    <div class="d-flex justify-content-between mt-5">

      {% if prev_index >= 0 %}
        {% assign prev = initiatives[prev_index] %}
        <a href="{{ prev.url | relative_url }}" class="btn btn-outline-primary">
          ← {{ prev.title }}
        </a>
      {% else %}
        <span></span>
      {% endif %}

      {% if next_index < initiatives.size %}
        {% assign next = initiatives[next_index] %}
        <a href="{{ next.url | relative_url }}" class="btn btn-outline-primary">
          {{ next.title }} →
        </a>
      {% endif %}

    </div>
  {% endif %}
</div>
