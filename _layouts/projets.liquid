---
layout: page
---

{% assign page_lang = page.lang | to_s | strip | downcase %}
{% assign page_permalink = page.permalink | to_s %}
{% assign page_url = page.url | to_s %}
{% assign is_english = false %}
{% if page_lang == 'en' or page_permalink contains '/en/' or page_url contains '/en/' %}
  {% assign is_english = true %}
{% endif %}
{% if is_english %}
  {% assign partners_label = 'Partners' %}
  {% assign contacts_label = 'TOTM Contacts' %}
  {% assign read_more_label = 'Read more' %}
  {% assign read_less_label = 'Show less' %}
  {% assign factsheet_label = 'View brief' %}
{% else %}
  {% assign partners_label = 'Partenaires' %}
  {% assign contacts_label = 'Contacts TOTM' %}
  {% assign read_more_label = 'En savoir plus' %}
  {% assign read_less_label = 'Réduire' %}
  {% assign factsheet_label = 'Voir la fiche' %}
{% endif %}

<section class="projects-page">
  {% for banner in page.banners %}
    <article class="project-card">
      <div class="project-media">
        <img src="{{ 'assets/img/' | append: banner.image | relative_url }}" alt="{{ banner.title }}">
      </div>

      <div class="project-content">
        <h2 class="project-title">{{ banner.title }}</h2>

        <div class="project-meta">
          <p><span class="meta-label">{{ partners_label }}:</span> {{ banner.partenaires }}</p>
          <p><span class="meta-label">{{ contacts_label }}:</span> {{ banner.contacts }}</p>
        </div>

        {% assign secondary_button_url = banner.secondary_button_url | default: banner.second_button_url %}
        {% assign secondary_button_label = banner.secondary_button_label | default: banner.second_button_label %}
        {% if banner.fiche or secondary_button_url %}
          <div class="buttons">
            {% if banner.fiche %}
              <a href="{{ banner.fiche | prepend: 'assets/pdf/' | relative_url }}" class="btn_projets btn_projets-secondary" target="_blank" rel="noopener noreferrer">
                {{ factsheet_label }}
              </a>
            {% endif %}
            {% if secondary_button_url and secondary_button_label %}
              <a href="{% if secondary_button_url contains '://' %}{{ secondary_button_url }}{% else %}{{ secondary_button_url | relative_url }}{% endif %}" class="btn_projets btn_projets-secondary" target="_blank" rel="noopener noreferrer">
                {{ secondary_button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        <div class="description">
          <div class="short-text">{{ banner.description | strip_html | normalize_whitespace | truncate: 220 }}</div>
          <div class="full-text">{{ banner.description | markdownify }}</div>
        </div>

        <div class="buttons">
          <button
            class="btn_projets show-more"
            type="button"
            data-more-label="{{ read_more_label }}"
            data-less-label="{{ read_less_label }}"
          >
            {{ read_more_label }}
          </button>
        </div>
      </div>
    </article>
  {% endfor %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.show-more').forEach((btn) => {
      btn.addEventListener('click', () => {
        const desc = btn.closest('.project-content').querySelector('.description');
        const isExpanded = desc.classList.toggle('expanded');
        const moreLabel = btn.dataset.moreLabel || 'En savoir plus';
        const lessLabel = btn.dataset.lessLabel || 'Réduire';
        btn.textContent = isExpanded ? lessLabel : moreLabel;
      });
    });
  });
</script>
