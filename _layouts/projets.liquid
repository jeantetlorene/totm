---
layout: page
---

{% assign is_english = page.lang == 'en' %}
{% if is_english %}
  {% assign partners_label = 'Partners' %}
  {% assign contacts_label = 'Contacts' %}
  {% assign read_more_label = 'Read more' %}
  {% assign read_less_label = 'Show less' %}
  {% assign factsheet_label = 'View brief' %}
{% else %}
  {% assign partners_label = 'Partenaires' %}
  {% assign contacts_label = 'Contacts' %}
  {% assign read_more_label = 'En savoir plus' %}
  {% assign read_less_label = 'Réduire' %}
  {% assign factsheet_label = 'Voir la fiche' %}
{% endif %}

<section class="projects-page">
  {% for banner in page.banners %}
    <article class="project-card">
      <div class="project-media">
        <img src="{{ 'assets/img/' | append: banner.image | relative_url }}" alt="{{ banner.title }}">
      </div>

      <div class="project-content">
        <h2 class="project-title">{{ banner.title }}</h2>

        <div class="project-meta">
          <p><span class="meta-label">{{ partners_label }}:</span> {{ banner.partenaires }}</p>
          <p><span class="meta-label">{{ contacts_label }}:</span> {{ banner.contacts }}</p>
        </div>

        <div class="description">
          <span class="short-text">{{ banner.description | strip_html | truncate: 190 }}</span>
          <span class="full-text">{{ banner.description }}</span>
        </div>

        <div class="buttons">
          <button
            class="btn_projets show-more"
            type="button"
            data-more-label="{{ read_more_label }}"
            data-less-label="{{ read_less_label }}"
          >
            {{ read_more_label }}
          </button>
          <a href="{{ banner.fiche | prepend: 'assets/pdf/' | relative_url }}" class="btn_projets btn_projets-secondary" target="_blank" rel="noopener noreferrer">
            {{ factsheet_label }}
          </a>
        </div>
      </div>
    </article>
  {% endfor %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.show-more').forEach((btn) => {
      btn.addEventListener('click', () => {
        const desc = btn.closest('.project-content').querySelector('.description');
        const isExpanded = desc.classList.toggle('expanded');
        const moreLabel = btn.dataset.moreLabel || 'En savoir plus';
        const lessLabel = btn.dataset.lessLabel || 'Réduire';
        btn.textContent = isExpanded ? lessLabel : moreLabel;
      });
    });
  });
</script>
