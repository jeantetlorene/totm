---
layout: page
---



{% for banner in page.banners %}
  <div class="project">
    <img src="{{ 'assets/img/' | append: banner.image | relative_url }}" alt="{{ banner.title }}">
    <div class="project-content">
      <h2>{{ banner.title }}</h2>
      <p><strong>Partenaires :</strong> {{ banner.partenaires }}</p>
      <p><strong>Contacts :</strong> {{ banner.contacts }}</p>
      <div class="description">
        <span class="short-text">{{ banner.description | truncate: 100 }}</span>
        <span class="full-text">{{ banner.description }}</span>
      </div>
      <div class="buttons">
        <button class="btn_projets show-more">En savoir plus</button>
        <a href="{{ banner.fiche | prepend: 'assets/pdf/' | relative_url }}" class="btn_projets" target="_blank"> Voir la fiche</a>
      </div>
    </div>
  </div>
{% endfor %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.show-more').forEach(btn_projets => {
      btn_projets.addEventListener('click', () => {
        const desc = btn_projets.closest('.project-content').querySelector('.description');
        const isExpanded = desc.classList.toggle('expanded');
        btn_projets.textContent = isExpanded ? 'Réduire' : 'En savoir plus';
      });
    });
  });
</script>

